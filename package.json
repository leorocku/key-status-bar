{
  "name": "keystatusbar",
  "version": "1.0.0",
  "description": "KeyStatusBar - Desktop Key Status Display",
  "author": "leorocku",
  "main": "build/main.js",
  "scripts": {
    "compile": "tsc && node scripts/copy-assets.js",
    "test": "npm run compile && node --test tests/*.test.js",
    "start": "npm run compile && start.bat",
    "build": "npm run compile && electron-builder"
  },
  "build": {
    "appId": "com.keystatusbar.app",
    "productName": "KeyStatusBar",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "build/**/*"
    ]
  },
  "dependencies": {
    "koffi": "3.0.2",
    "@koromix/koffi-win32-x64": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.9.3"
  }
}
